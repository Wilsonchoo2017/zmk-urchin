#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

// Layer definitions
#define BASE 0
#define SYM 1
#define EXT 2
#define FNC 3
#define SYM2 4
#define SETTINGS 5
// -----------------

#define COMBO_TERM_NORMAL 22
#define COMBO_TERM_LONG 51
#define COMBO_TERM_EXTRALONG 123

// ------

/ {
	behaviors {
		// Enables holding the first mod-tap key
		// by performing a tap-release-hold sequence.
		// To use it: "&qt KEYCODE1 KEYCODE2"
		qt: quick_tap {
			compatible = "zmk,behavior-hold-tap";
			label = "QUICK_TAP";
			#binding-cells = <2>;
			flavor = "hold-preferred";
			tapping-term-ms = <200>;
			quick-tap-ms = <200>;
			bindings = <&kp>, <&kp>;
		};

		// Sticky layer that drops on the next key PRESS instead of
		// the next key release. The default &sl keeps the layer live
		// until the next key is released, so a cross-hand roll off a
		// symbol (' then s) still lands on the symbol layer and gave
		// '% instead of 's.
		sl_q: sticky_layer_quick {
			compatible = "zmk,behavior-sticky-key";
			label = "STICKY_LAYER_QUICK";
			#binding-cells = <1>;
			bindings = <&mo>;
			release-after-ms = <1000>;
			quick-release;
			ignore-modifiers;
		};

		// Sticky layer that only arms once the key is RELEASED.
		// A bare "&sl" binds "&mo", so the layer is live while the
		// thumb is still down and fast rolls leak into it
		// (typing ' then s produced '% because SYM pos 11 is %).
		// Wrapping it in a hold-tap makes the layer inert until the
		// tap resolves; keys pressed in the meantime are captured
		// and replayed afterwards, so the roll comes out in order.
		// Hold past the tapping term still gives momentary access.
		// To use it: "&slt LAYER LAYER"
		slt: sticky_layer_tap {
			compatible = "zmk,behavior-hold-tap";
			label = "STICKY_LAYER_TAP";
			#binding-cells = <2>;
			flavor = "tap-preferred";
			tapping-term-ms = <250>;
			bindings = <&mo>, <&sl_q>;
		};
	};

	macros {
		// sometimes my device thinks a modifier is being held down
		// pressing all modifiers fixes it.
		unstick: unstick {
			label = "ZM_unstick";
			compatible = "zmk,behavior-macro";
			#binding-cells = <0>;
			bindings = <&kp LSHIFT &kp RSHIFT &kp LCTRL &kp RCTRL &kp LALT &kp RALT &kp LGUI &kp RGUI>;
		};
	};

	combos {
		compatible = "zmk,combos";
		// internal-left & external-right thumb keys
		combo_sym2 {
			timeout-ms = <COMBO_TERM_NORMAL>;
			key-positions = <31 33>;
			bindings = <&mo SYM2>;
		};
		// both left thumb keys
		combo_settings {
			timeout-ms = <COMBO_TERM_NORMAL>;
			key-positions = <30 31>;
			bindings = <&mo SETTINGS>;
		};
		// Base 
		// q w - ESC
		base_esc {
			timeout-ms = <COMBO_TERM_EXTRALONG>;
			key-positions = <0 1>;
			bindings = <&kp ESC>;
			layers = <BASE>;
		};

		// q w e - Tab
		base_tab {
			// 3 keys inside 22ms is barely hittable; LONG makes it reliable
			timeout-ms = <COMBO_TERM_LONG>;
			key-positions = <0 1 2>;
			bindings = <&kp TAB>;
			layers = <BASE>;
		};

    // k; - Backspace
		base_backspace {
			timeout-ms = <COMBO_TERM_LONG>;
			key-positions = <17 19>;
			bindings = <&kp BSPC>;
			layers = <BASE>;
		};

    // l ; - Apostrophe
		// Mirrors QWERTY, where ' sits just past ;. Neither key rolls
		// into the other in prose, so a long window is safe here and
		// keeps the most common punctuation off the SYM layer.
		base_apostrophe {
			timeout-ms = <COMBO_TERM_EXTRALONG>;
			key-positions = <18 19>;
			bindings = <&kp SINGLE_QUOTE>;
			layers = <BASE>;
		};

    // , . - Enter
		base_enter {
			timeout-ms = <COMBO_TERM_EXTRALONG>;
			key-positions = <27 28>;
			bindings = <&kp ENTER>;
			layers = <BASE>;
		};
};

	keymap {
		compatible = "zmk,keymap";
		// Base alpha layer
		default_layer {
			label = "Base";
			bindings = <
			&kp Q &kp W &kp E &kp R &kp T           &kp Y &kp U  &kp I     &kp O   &kp P 
			&kp A &kp S &kp D &kp F &kp G           &kp H &kp J  &kp K     &kp L &kp SEMICOLON
			&kp Z &kp X &kp C &kp V &kp B           &kp N &kp M  &kp COMMA &kp DOT &kp SLASH
							&mo EXT &kp SPACE           &kp SPACE &slt SYM SYM
			>;
		};

		// Numbers and high frequency symbols
		sym_layer {
			label = "Sym.";
			bindings = <
			&kp N1 &kp N2 &kp N3 &kp N4 &kp N5		                                    							 &kp N6 &kp N7 &kp N8 &kp N9 &kp N0
			&none &kp PERCENT &kp LEFT_PARENTHESIS &kp LEFT_BRACE &kp LEFT_BRACKET 	    		 &kp EQUAL  &none  &none &kp PLUS &kp ASTERISK
			&none &kp DOLLAR &kp RIGHT_PARENTHESIS &kp RIGHT_BRACE &kp RIGHT_BRACKET      &kp AT_SIGN &kp EXCLAMATION &kp DOUBLE_QUOTES &kp MINUS &kp SLASH 
														&mo FNC  &mo SYM2       &trans &trans
			>;
		};

		// Main modifiers and arrow keys
		ext_layer {
			label = "Mods";
			bindings = <
			&kp ESC  &kp C_PREV &kp C_PP  &kp C_NEXT  &kp C_PAUSE    	&kp PG_UP  &kp HOME &kp UP &kp END &none
			&sk LALT &sk LGUI  &sk LSHIFT  &sk LCTRL  &caps_word 		&kp PG_DN &kp LEFT  &kp DOWN  &kp RIGHT   &kp DEL
			 &trans  &trans &trans &trans &kp TAB           &none &kp BSPC &none &none  &none
																		&trans &kp LCTRL    &kp ENTER  &mo FNC 
			>;
		};

		// Function keys with modifiers
		fnc_layer {
			label = "FRow";
			bindings = <
			&kp F1 &kp F2 &kp F3 &kp F4 &kp F5                  &kp F6 &kp F7 &kp F8 &kp F9 &kp F10 
			&sk LALT &sk LGUI &sk LSHIFT &sk LCTRL &none     &kp F11 &kp F12  &kp PRINTSCREEN &trans &trans
			&none &none &none &none &none				          &none &none &none &none &none 
							  &none &none              &none &none  
			>;
		};

		// Low frequency symbols.
		symbols_2_layer {
			label = "Sym.2";
			bindings = <
			&kp CARET &kp UNDERSCORE &kp LESS_THAN &kp GREATER_THAN &kp HASH    &none &none &none &none &none
			&kp GRAVE &kp TILDE &kp BACKSLASH &kp PIPE &kp AMPERSAND              &none &none &none &none &none
			&none 			&none 			 &kp QUESTION &kp COLON &none				  &none &none &none &none &none
																	&none &none        	&none &none 
			>;
		};

		// Used to change the keyboard's settings.
		settings_layer {
				label = "Sett.";
				bindings = <
				&bootloader &none &none &bt BT_CLR &bt BT_SEL 0               &bt BT_SEL 3 &none &unstick &none &bootloader 
				&none &none &none &none      &bt BT_SEL 1 						  &bt BT_SEL 4 &none &none &none &none
				&studio_unlock &none &none &none      &bt BT_SEL 2               &bt BT_SEL 5 &none &none &none &studio_unlock
										&none &none                         &none &none 
				>;
		};

	};
};
